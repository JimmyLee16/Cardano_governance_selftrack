# PostgreSQL Connection (required)
# Format: postgresql://user:pass@host:5432/dbname?sslmode=require
# Works with: Railway, Render, Fly.io, local, Docker, etc.
DATABASE_URL=

# Blockfrost Project ID (required for DRep list/info)
BLOCKFROST_PROJECT_ID=

# IPFS Gateway (optional, defaults to https://ipfs.io/ipfs/)
# IPFS_GATEWAY=https://ipfs.io/ipfs/

# OpenAI-compatible API (for generate_ai_summaries.py)
# Works with: OpenAI, Azure OpenAI, NIM, Groq, Together, OpenRouter, Ollama, vLLM, LM Studio, etc.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini